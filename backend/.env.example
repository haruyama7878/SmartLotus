DATABASE_URL=jdbc:postgresql://localhost:5432/smart_lotus
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable only after Supabase JWT issuer is configured.
SECURITY_ENABLED=false
SUPABASE_ISSUER_URI=https://your-project.supabase.co/auth/v1

# Local development identity when SECURITY_ENABLED=false.
SMARTLOTUS_USER_ID=local-development-user
SMARTLOTUS_USER_EMAIL=student@smartlotus.local
SMARTLOTUS_USER_NAME=Học sinh phát triển
SMARTLOTUS_USER_ROLE=student

# Trái tim cá nhân hóa (Gemma qua Google AI Studio). Lấy key tại https://aistudio.google.com/apikey
GEMMA_API_KEY=
GEMMA_API_MODEL=gemma-4-31b-it
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
